# Apple product photography fetched during the fidelity check is
# Apple-copyrighted and must not be redistributed
reference/

# Full-resolution Cycles output: 12 MB of PNG. The web-optimised JPEGs under
# docs/images/ are what the site actually serves.
renders/*.png
renders/small/
renders/tiny/

# Blender generated
*.blend
*.blend1
mac_studio.blend

# Measurement scratch. Working crops, crops-of-crops, ASCII dumps, candidate
# lattice overlays and per-band comparison sheets. Everything here is
# reproducible from tools/ plus reference/ and none of it is an input to the
# build, so tracking it would only add ~17 MB of intermediate images that go
# stale on the next run.
renders/compare/

# Output of tools/verify_front_ports.py: the front-elevation screenshot the
# ray probe takes, kept for the record beside the numbers it produced. A
# screenshot of a claim, not a deliverable - the numbers are the verdict.
renders/verify/

# Scratch working directory: a throwaway Blender.app (973 MB), .bak copies,
# compiled dylib and object-file debris from an injection probe, captured
# stdout and ad-hoc probe scripts. Nothing in here is an input to anything,
# and the size alone makes it uncommittable.
tmp/

# Python
__pycache__/
*.pyc

# OS
.DS_Store
# AppleDouble sidecars. macOS creates ._name for names containing a colon, and
# the resource-fork copy shows up as a .!NNN!name file next to the original.
._*
.!*
